# --- Cloudinary (file uploads: headshots, showreels, gallery) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=actors_carved_unsigned

# --- Resend (transactional / admin notification email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Actors Carved Studio <notifications@actorscarved.com>"
ADMIN_NOTIFICATION_EMAIL=infoacsfilms@gmail.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.actorscarved.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919911299301

# --- Rate limiting (optional, falls back to in-memory limiter if unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
